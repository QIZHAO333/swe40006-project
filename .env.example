# Copy this file to .env and change the values.
# .env is in .gitignore, so real passwords never go into GitHub.

POSTGRES_USER=studyboard
POSTGRES_PASSWORD=change-me
POSTGRES_DB=studyboard

# development, staging or production. Shown in the footer.
APP_ENV=development

# Port on your laptop. Change it if 8000 is already in use.
WEB_PORT=8000

APP_TIMEZONE=Australia/Melbourne
